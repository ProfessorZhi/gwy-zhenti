# ~/.config/systemd/user/fenbi-collector.service
# 采集：目录巡检 → 建队列 → 抓题 → 交白卷读解析 → 回填 → 下图片，一直循环。
# 从仓库 main 的 checkout 运行；部署 = git pull + systemctl --user restart fenbi-collector。
[Unit]
Description=Fenbi collector (single browser owner)
After=network-online.target

[Service]
WorkingDirectory=/home/fjd/workspaces/gwy-zhenti-main
Environment=FENBI_BASE=/home/fjd/workspaces/gwy-zhenti-main
# 运行数据（登录 Profile、缓存）沿用原来的 work 目录，不随代码目录变化
Environment=FENBI_WORK_DIR=/home/fjd/workspaces/gwy-zhenti-fenbi/repo/work/fenbi
Environment=SERVICE_BATCH=30 SERVICE_INTERVAL=10 SERVICE_FOCUS_RESCAN=7200 SERVICE_BACKOFF=900
ExecStart=/usr/bin/node tools/fenbi/driver/fenbi-service.mjs
# 进程意外退出就重启；写了 STOP（风控信号）时服务启动后会立刻退出，不会去访问粉笔
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
