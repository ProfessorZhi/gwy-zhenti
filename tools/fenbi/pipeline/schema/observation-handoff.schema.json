{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gwy-zhenti/observation-handoff.schema.json",
  "title": "gwy-zhenti source observation handoff",
  "type": "object",
  "required": ["schemaVersion", "kind", "producer", "permissions", "observations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "gwy-zhenti-source-observation" },
    "producer": {
      "type": "object",
      "required": ["agent", "at"],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string", "minLength": 1, "maxLength": 80 },
        "at": { "type": "string", "format": "date-time" }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["browserProfile", "cookies", "tokens"],
      "additionalProperties": false,
      "properties": {
        "browserProfile": { "const": false },
        "cookies": { "const": false },
        "tokens": { "const": false }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["paperSourceId", "title", "subject", "area", "year", "route", "rights"],
        "additionalProperties": false,
        "properties": {
          "paperSourceId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,120}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "subject": { "enum": ["xingce", "shenlun"] },
          "area": { "type": "string", "minLength": 1, "maxLength": 40 },
          "year": { "type": "integer", "minimum": 2016 },
          "variant": { "type": ["string", "null"], "maxLength": 40 },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "questionCount": { "type": "integer", "minimum": 1 },
          "contentStatus": { "enum": ["observed", "placeholder", "unknown"] },
          "route": {
            "type": "object",
            "required": ["kind", "urlObserved", "contentStatus"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["existing_practice", "not_found", "multiple", "not_initialized", "blocked_auth"] },
              "url": { "type": ["string", "null"] },
              "urlObserved": { "type": "boolean" },
              "contentStatus": { "enum": ["observed", "placeholder", "unknown"] },
              "questionCount": { "type": "integer", "minimum": 1 },
              "imageContentOnly": { "type": "boolean" },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "ref"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string", "maxLength": 80 },
                    "ref": { "type": "string", "maxLength": 500 },
                    "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
                  }
                }
              }
            }
          },
          "rights": {
            "type": "object",
            "required": ["category", "redistribution"],
            "additionalProperties": false,
            "properties": {
              "category": { "enum": ["observed_ui", "official", "licensed_donor"] },
              "license": { "type": ["string", "null"], "maxLength": 200 },
              "redistribution": { "enum": ["local_only", "allowed"] },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "ref"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string", "maxLength": 80 },
                    "ref": { "type": "string", "maxLength": 500 },
                    "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
                  }
                }
              }
            }
          },
          "images": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": ["ref"],
              "additionalProperties": false,
              "properties": {
                "ref": { "type": "string", "minLength": 1, "maxLength": 500 },
                "sourceUrl": { "type": ["string", "null"] },
                "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
