# TEMPLATE ONLY — do not enable or install from this repository.
# Copy as ~/.config/systemd/user/fenbi-pipeline.service; replace
# REPO_ABSOLUTE_PATH with the absolute checkout path and NODE_ABSOLUTE_PATH
# with the verified absolute Node 22 executable path before installation.
# systemd does not expand shell variables in ExecStart: the path below must be
# a literal path after substitution. Environment files stay outside the repo.
[Unit]
Description=Fenbi collector service (archived source template)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=REPO_ABSOLUTE_PATH
ExecStart=NODE_ABSOLUTE_PATH REPO_ABSOLUTE_PATH/tools/fenbi/driver/fenbi-service.mjs
# Optional local overrides (never commit): FENBI_BASE, FENBI_WORK_DIR,
# SERVICE_BATCH, SERVICE_INTERVAL, SERVICE_FOCUS_RESCAN, SERVICE_FOCUS_PAGES.
# Single-paper worker: SERVICE_MODE=worker, INTEG_REPO, RIGHTS_FILE, PUSH=1, AUTO_MERGE=1,
# WORKER_TABS, WORKER_DWELL_MS, WORKER_MAX_PAPERS (see docs/WORKFLOW-THINKING.md).
# EnvironmentFile=-%h/.config/gwy-zhenti/collector.env
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
